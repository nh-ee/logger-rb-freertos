# STM32CubeIDE build output
*/Debug/*
*/Release/*
*/build/*
*/Binaries/*
*.elf
*.map
*.bin
*.hex
*.o
*.d

# STM32CubeMX generated files (temporary)
/*.ioc~*
/*.log

# IDE cache
.metadata/

# IDE settings (user-specific)
#.cproject
#.project
.settings/

# STM32CubeIDE metadata (optional - keep .mxproject and .ioc for reproducibility)
/STM32CubeIDE/.loadpath
#/STM32CubeIDE/.cproject
#/STM32CubeIDE/.project
/STM32CubeIDE/.settings/

# Auto-generated code that can be regenerated by STM32CubeMX (optional)
/Drivers/STM32*/**/startup_*.s
/Drivers/STM32*/**/system_*.c

# Backup files
*~
*.bak
*.tmp

# OS-specific
.DS_Store
Thumbs.db
